{
  "name": "porto-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/bake-fits.mjs --if-stale",
    "bake:fits": "node scripts/bake-fits.mjs",
    "check:fits": "node scripts/bake-fits.mjs --check",
    "build": "vite build",
    "preview": "vite preview",
    "verify": "node scripts/verify.mjs",
    "perf": "node scripts/perf-bench.mjs --reduced --check",
    "perf:full": "node scripts/perf-bench.mjs --check --out perf/results.json",
    "perf:serve": "node scripts/perf-serve.mjs",
    "pack:buildings": "node scripts/pack-buildings.mjs",
    "check:data": "node scripts/check-data.mjs --city porto",
    "check:geo": "node scripts/check-geo.mjs --city porto",
    "check:coast": "node scripts/check-coast.mjs --city porto",
    "fetch:coast": "node scripts/fetch-coast.mjs --city porto",
    "check:dimensions": "node scripts/check-dimensions.mjs --city porto",
    "check:fit": "node scripts/check-fit.mjs --city porto",
    "check:traffic": "node scripts/check-traffic.mjs --city porto",
    "check:models": "node scripts/count-tris.mjs --city porto",
    "count-tris": "node scripts/count-tris.mjs --city porto",
    "city": "node scripts/city.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "vite": "^8.3.1"
  }
}
